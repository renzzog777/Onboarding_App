# Copy this file to .env on the VPS and fill in a real password.
# .env is never committed to git (see .gitignore) - it only ever lives
# on the VPS itself.

ADMIN_PASSWORD=change-this-to-a-real-password

# Tutorials assistant (optional). Leave GEMINI_API_KEY unset to hide it.
# Get a key at https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=
# Model to use (change it if Google renames or retires it).
GEMINI_MODEL=gemini-3.5-flash

# Local AI (Ollama on this server, localhost only) - see ai/llm.py.
# LLM_PROVIDER picks the chat model: gemini (default) or ollama.
# Embeddings for the knowledge base always use Ollama.
LLM_PROVIDER=gemini
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:2b
EMBED_MODEL=qwen3-embedding:0.6b
LLM_TIMEOUT=90
LLM_REASONING_EFFORT=none
