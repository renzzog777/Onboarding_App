# Copy this file to .env on the VPS and fill in a real password.
# .env is never committed to git (see .gitignore) - it only ever lives
# on the VPS itself.

ADMIN_PASSWORD=change-this-to-a-real-password

# Tutorials assistant (optional). Leave GEMINI_API_KEY unset to hide it.
# Get a key at https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=
# Model to use (change it if Google renames or retires it).
GEMINI_MODEL=gemini-3.5-flash
